#%PAM-1.0
# Test service: same branches as pam.d/sddm, without unlocking the keyring.
# Run as root: pamtester pam-tpm-keyring-test <user> authenticate
# Type the password, or press Enter to scan a fingerprint; the debug lines in
# the journal say where the keyring key came from.

auth        [success=2 ignore=ignore default=die]  pam_tpm_keyring.so  fingerprint debug
auth        requisite   pam_unix.so             use_first_pass
auth        optional    pam_tpm_keyring.so      seal debug
auth        required    pam_permit.so

account     required    pam_permit.so
