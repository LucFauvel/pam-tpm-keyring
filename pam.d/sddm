#%PAM-1.0
# SDDM login with password or fingerprint, unlocking the GNOME keyring either way.
# An empty password means "scan a fingerprint" (the theme sends one); a typed
# password goes through pam_unix as usual.
#
# This spells out system-login's auth section instead of including it, because
# the fingerprint branch has to rejoin the stack before pam_gnome_keyring.

auth        required    pam_shells.so
auth        requisite   pam_nologin.so
auth        required    pam_faillock.so         preauth
# Empty password: fingerprint. On a match, skip to pam_env with the unsealed
# keyring key in PAM_AUTHTOK. Typed password: PAM_IGNORE, fall through.
auth        [success=3 ignore=ignore default=die]  pam_tpm_keyring.so  fingerprint
auth        [success=1 default=ignore]  pam_unix.so     use_first_pass
auth        [default=die]               pam_faillock.so authfail
# Password path: swap the password for the keyring key, keep the TPM copy current.
auth        optional    pam_tpm_keyring.so      seal
auth        required    pam_env.so
auth        required    pam_faillock.so         authsucc
-auth       optional    pam_gnome_keyring.so
-auth       optional    pam_kwallet5.so

account     include     system-login

password    include     system-login
# The keyring's password is the keyring key, so pam_gnome_keyring can't follow
# a password change; this rewraps the key instead.
password    optional    pam_tpm_keyring.so

session     optional    pam_keyinit.so          force revoke
session     include     system-login
-session    optional    pam_gnome_keyring.so    auto_start
-session    optional    pam_kwallet5.so         auto_start
